---
import '../styles/global.css';

const { title = 'Home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A practical exploration of prayer and belief." />
    <title>{title} | Who to Pray to</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="profile-wrap">
          <div class="top-row">
            <img class="header-image" src={`${base}/images/home/pray_4.jpg`} alt="Person praying at sunset" />

            <div class="profile-text">
              <p class="profile-role">Professor of Humanities</p>
              <p class="profile-tagline">Scholar • Writer • Teacher</p>
            </div>

            <div class="header-title-wrap">
              <h1 class="header-title">Who to Pray to</h1>
            </div>

            <div class="header-actions">
              <a class="header-cta" href={`${base}/contact`}>Contact Us</a>
            </div>
          </div>
        </div>
      </header>

      <main>
        {title !== 'Home' && (
          <div class="content-home-link">
            <a href={`${base}/`} class="home-button">Home</a>
          </div>
        )}
        <slot />
        {title !== 'Home' && (
          <div class="content-home-link content-home-link-bottom">
            <a href={`${base}/`} class="home-button">Home</a>
          </div>
        )}
      </main>
    </div>
  </body>
</html>
