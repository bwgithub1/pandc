---
import '../styles/global.css';

const { title = 'Home' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A practical exploration of prayer and belief." />
    <title>{title} | Who to Pray to</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="profile-wrap">
            <p class="profile-role">Professor of Humanities</p>

            <div class="top-row">
              <a href="/" class="brand" aria-label="Home">PandC</a>
              <h1 class="header-title">Who to Pray to</h1>
              <span class="right-placeholder" aria-hidden="true"></span>
            </div>

            <p class="profile-tagline">Scholar • Writer • Teacher</p>
          </div>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
