---
import MainLayout from '../layouts/MainLayout.astro';
import HomeGrid from '../components/HomeGrid.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { href: `${base}/intro`, label: 'Intro', image: `${base}/images/home/intro_1.jpg`, excerpt: 'Overview and purpose.' },
  { href: `${base}/true-believers`, label: 'For Believers', image: `${base}/images/home/believer.jpg`, excerpt: 'Guidance for believers.' },
  { href: `${base}/seekers`, label: 'For Seekers', image: `${base}/images/home/seeker.jpg`, excerpt: 'Questions for seekers.' },
  { href: `${base}/doubters`, label: 'For Doubters', image: `${base}/images/home/doubler.jpg`, excerpt: 'Reflections for doubters.' },
  { href: `${base}/what-science-says`, label: 'Science Says', image: `${base}/images/home/science.jpg`, excerpt: 'Evidence and inquiry.' },
  { href: `${base}/my-journey`, label: 'My Journey', image: `${base}/images/home/my_jouney.jpg`, excerpt: 'A personal narrative.' },
  { href: `${base}/our-purpose`, label: 'Our Purpose', image: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0', excerpt: 'Why this project exists.' },
  { href: `${base}/secular-places`, label: 'Secular Places', image: 'https://images.unsplash.com/photo-1472214103451-9374bd1c798e', excerpt: 'Non-religious contexts.' },
  { href: `${base}/evolution`, label: 'Evolution', image: `${base}/images/home/evalution.jpg`, excerpt: 'Origins and change.' },
  { href: `${base}/where-we-are-headed`, label: 'Where we are headed', image: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470', excerpt: 'Future directions.' }
];
---

<MainLayout title="Home">
  <section class="home-section">
    <HomeGrid items={items} />
  </section>
</MainLayout>
