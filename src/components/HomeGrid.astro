---
const { items = [] } = Astro.props;
---
<ul class="home-grid" role="list">
  {items.map((item, index) => (
    <li
      class="card"
      key={item.href}
      style={index === 4 || index === 5 ? 'grid-column: span 2;' : ''}
    >
      <a href={item.href} aria-label={item.label}>
        <img src={`${item.image}?v=2`} alt={item.label + ' image'} />
        <h3>{item.label}</h3>
      </a>
    </li>
  ))}
</ul>
