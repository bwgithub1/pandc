---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/publications', label: 'Publications' },
  { href: '/articles', label: 'Articles' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' }
];
---

<nav class="nav">
  {links.map((link) => (
    <a href={link.href}>{link.label}</a>
  ))}
</nav>
